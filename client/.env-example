VITE_CLIENT_BASE_URL=http://localhost:3000
VITE_SERVER_BASE_URL=http://localhost:10020

# Production values (Vite embeds these at build time — rebuild after changing):
#   VITE_CLIENT_BASE_URL=https://www.lengua-app.com
#   VITE_SERVER_BASE_URL=https://api.lengua-app.com

# Google OAuth Web-application client ID (same value as the server's
# GOOGLE_CLIENT_ID). Authorized JavaScript origin in production:
# https://www.lengua-app.com
VITE_GOOGLE_CLIENT_ID=
