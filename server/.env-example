NODE_ENV=development
PORT=10020
JWT_SECRET=myLittleSecret
DATABASE_URL=postgres://postgres:pass@postgres:5432/serverdev
REDIS_URL=redis://redis:6379

# Google OAuth (Web application client from Google Cloud Console).
# Required for "Continue with Google" sign-in. The mobile endpoint
# (POST /v1/auth/google) verifies the Google ID token directly against these
# audiences. Same GOOGLE_CLIENT_ID as the client's VITE_GOOGLE_CLIENT_ID.
# Production client authorized origin: https://www.lengua-app.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# iOS OAuth client id. The iOS app sets GIDServerClientID to the web client,
# so ID tokens usually carry the web aud, but accept the iOS aud too.
GOOGLE_IOS_CLIENT_ID=
